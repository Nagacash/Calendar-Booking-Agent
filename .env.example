# Copy to .env and fill with YOUR keys (never commit .env)

# Synthesia — Interactive Avatars scope
# https://app.synthesia.io → Developers → API keys
SYNTHESIA_API_KEY=

# Optional: gallery avatar id (defaults to Kenji if empty)
SYNTHESIA_AVATAR_ID=7572faa9-15da-400d-8227-ef1ab8932523

# LiveKit Cloud — create your own project at https://cloud.livekit.io
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name must match the agent you create/select in LiveKit Cloud Console
LIVEKIT_AGENT_NAME=calendar-avatar
